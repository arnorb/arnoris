---
import Base from "../layouts/Base.astro";

const links = [
  { label: "Email", href: "mailto:arnor@arnor.is" },
  { label: "GitHub", href: "https://github.com/arnorb" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/arnorb" },
];
---

<Base
  title="Arnór Bogason"
  description="Design Engineer at Húsvör, based in Reykjavík."
  canonicalPath="/"
>
  <h1>Arnór Bogason</h1>
  <p>Design Engineer at Húsvör, based in Reykjavík.</p>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
