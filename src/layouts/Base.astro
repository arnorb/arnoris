---
interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/". Omit on pages that should not be indexed. */
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonical = canonicalPath ? new URL(canonicalPath, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {!canonical && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="preload" href="/fonts/inter-var-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline src="https://cdn.usefathom.com/script.js" data-site="KJMPLXTI" defer></script>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Inter";
    src: url("/fonts/inter-var-latin.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215,
      U+FEFF, U+FFFD;
  }

  /* Metric-matched fallback so text does not shift when Inter loads. */
  @font-face {
    font-family: "Inter Fallback";
    src: local("Arial");
    ascent-override: 90.44%;
    descent-override: 22.52%;
    line-gap-override: 0%;
    size-adjust: 107.12%;
  }

  :root {
    --color-bg: #fafaf9;
    --color-text: #18181b;
    --color-muted: #57575f;
    --color-link-line: #a1a1aa;
    --color-focus: #2563eb;

    --font-sans: "Inter", "Inter Fallback", system-ui, sans-serif;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-bg: #111113;
      --color-text: #ededef;
      --color-muted: #a1a1aa;
      --color-link-line: #5f5f68;
      --color-focus: #93c5fd;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.55;
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
  }

  main {
    width: 100%;
    max-width: calc(36rem + 2 * 1.5rem);
    margin-inline: auto;
    padding: 4rem 1.5rem;
  }

  @media (max-width: 480px) {
    main {
      padding-inline: 1rem;
    }
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  p {
    margin: 0.75rem 0 0;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-color: var(--color-link-line);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 120ms ease;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
